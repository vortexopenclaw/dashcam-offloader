{
  "name": "dashcam-offloader-desktop",
  "version": "0.2.0",
  "author": "Vortex Radar",
  "private": true,
  "updateEnabled": false,
  "description": "Cross-platform, read-only dashcam footage offloader",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package:mac": "bash scripts/package-mac.sh",
    "package:linux": "electron-builder --linux AppImage deb",
    "package:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.vortexradar.dashcam-offloader",
    "productName": "Dashcam Offloader",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://dashcam-offloader-updates.vortexradar.workers.dev/dashcam-offloader/desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "../assets/AppIcon.icns"
    },
    "linux": {
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "electron-winstaller@5.4.0": true
  }
}
